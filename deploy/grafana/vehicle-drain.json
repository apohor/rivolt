{
  "title": "Rivolt: vehicle parked drain",
  "uid": "rivolt-vehicle-drain",
  "tags": [
    "rivolt",
    "drain"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "description": "D1 drain experiment instrument. Gauges come from vehicle_state (internal/drain), recomputed every 15 min. Every pod exports the same series: always aggregate with max by (vehicle, window), never sum. Admin only: the vehicle label is the Rivian vehicle id.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "vehicle",
        "label": "Vehicle",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(rivolt_vehicle_parked_hours, vehicle)",
          "refId": "V"
        },
        "definition": "label_values(rivolt_vehicle_parked_hours, vehicle)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Parked drain, %/day (7 d rolling)",
      "description": "SoC lost per day while parked over the last 7 days. Gate A metric. Absent under 24 parked hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_parked_drain_pct_per_day{window=\"7d\",vehicle=~\"$vehicle\"})",
          "legendFormat": "{{vehicle}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Parked drain, %/day (24 h rolling)",
      "description": "Absent under 6 parked hours. Noisy: SoC moves in 0.1-1 point steps.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_parked_drain_pct_per_day{window=\"24h\",vehicle=~\"$vehicle\"})",
          "legendFormat": "{{vehicle}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Idle-awake, h/day",
      "description": "Hours awake while parked and not charging, per 24 h of recorded power state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle, window) (rivolt_vehicle_idle_awake_hours_per_day{vehicle=~\"$vehicle\"})",
          "legendFormat": "{{vehicle}} {{window}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Quick re-wakes (sleeps under 60 s), last 24 h",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_quick_rewakes{window=\"24h\",vehicle=~\"$vehicle\"})",
          "legendFormat": "{{vehicle}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Median sleep length (24 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_median_sleep_seconds{window=\"24h\",vehicle=~\"$vehicle\"})",
          "legendFormat": "{{vehicle}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Quick re-wake share (24 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_quick_rewakes{window=\"24h\",vehicle=~\"$vehicle\"}) / clamp_min(max by (vehicle) (rivolt_vehicle_sleeps{window=\"24h\",vehicle=~\"$vehicle\"}), 1)",
          "legendFormat": "{{vehicle}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Fleet now (7 d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 18,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_parked_drain_pct_per_day{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_idle_awake_hours_per_day{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_quick_rewakes{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_sleeps{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_median_sleep_seconds{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vehicle) (rivolt_vehicle_parked_hours{window=\"7d\",vehicle=~\"$vehicle\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "drain %/day",
              "Value #B": "idle-awake h/day",
              "Value #C": "quick re-wakes",
              "Value #D": "sleeps",
              "Value #E": "median sleep s",
              "Value #F": "parked h"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "drain %/day",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Metrics age",
      "description": "Seconds since the drain metrics were last computed (every 15 min by default).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(rivolt_drain_metrics_last_success_timestamp_seconds)",
          "instant": true
        }
      ]
    }
  ]
}
